# Doxygen configuration for the Build-Optimization C++ backend (backend/).
# Build with: doxygen docs/cpp/Doxyfile   (run from the repo root)

PROJECT_NAME           = "Build-Optimization C++ Backend"
PROJECT_BRIEF          = "Exact and combinatorial knapsack-routing solvers, exposed to Python via pybind11"
PROJECT_NUMBER         = 0.1.0

# Paths are relative to the directory doxygen is invoked from (repo root).
INPUT                  = backend/include backend/src
OUTPUT_DIRECTORY       = docs/_build/api/cpp-doxygen
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.c *.cpp
EXCLUDE_PATTERNS       = */build/* */build-*/* */_deps/*

# Extraction — document everything public; keep internals out.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
INTERNAL_DOCS          = NO
WARN_IF_UNDOCUMENTED   = YES
QUIET                  = YES

# C++17 parsing behaviour
BUILTIN_STL_SUPPORT    = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES

# Output — HTML only (the MkDocs umbrella links to it).
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = AUTO_DARK

# Diagrams (uses dot from graphviz if available; degrades gracefully).
HAVE_DOT               = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO

# Source browsing
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
