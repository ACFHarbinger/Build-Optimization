  "name": "Build-Optimization Studio (Tauri Frontend)",
  "entryPoints": ["../../frontend/src"],
  "entryPointStrategy": "expand",
  "tsconfig": "../../frontend/tsconfig.json",
  "out": "../_build/api/frontend",
