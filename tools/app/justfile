# Build-Optimization — App: GUI and Tauri Studio interfaces

set unstable := true
set working-directory := '../..'

# Launch the GUI
gui:
    uv run python main.py gui

# Launch the Tauri Studio desktop app (dev mode, hot reload)
studio:
    cd frontend && npm run tauri:dev

# Build the Tauri Studio release bundle
studio-build:
    cd frontend && npm run tauri:build
