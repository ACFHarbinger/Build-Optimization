{
  "name": "build-optimization-extension",
  "private": true,
  "version": "0.1.0",
  "description": "Browser extension that scrapes item and build data from game wikis (Fandom and similar) into Build-Optimization's data pipeline",
  "scripts": {
    "build:chrome": "webpack --config webpack.chrome.js",
    "build:firefox": "webpack --config webpack.firefox.js",
    "build:edge": "webpack --config webpack.edge.js",
    "build:all": "npm run build:chrome && npm run build:firefox && npm run build:edge",
    "watch:chrome": "webpack --config webpack.chrome.js --watch",
    "watch:firefox": "webpack --config webpack.firefox.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/jest": "^30",
    "copy-webpack-plugin": "^14",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-loader": "^9",
    "typescript": "^7",
    "webpack": "^5",
    "webpack-cli": "^7",
    "webpack-merge": "^6"
  }
}
