{
  "name": "build-optimization-root",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "extension"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "setup": "npm run install:all",
    "dev": "npm run tauri:dev",
    "build": "npm run tauri:build",
    "tauri": "npm run tauri --workspace=frontend --",
    "tauri:dev": "npm run tauri:dev --workspace=frontend",
    "tauri:build": "npm run tauri:build --workspace=frontend",
    "start-frontend": "npm run dev --workspace=frontend",
    "build-frontend": "npm run build --workspace=frontend",
    "test-frontend": "npm run test --workspace=frontend",
    "build-extension": "npm run build:all --workspace=extension",
    "test-extension": "npm run test --workspace=extension",
    "lint": "npm run lint --workspace=frontend && npm run typecheck --workspace=extension",
    "test": "npm run test-frontend && npm run test-extension"
  },
  "devDependencies": {
    "concurrently": "^10"
  }
}
