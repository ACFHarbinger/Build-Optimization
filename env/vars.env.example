# Copy to env/vars.env (gitignored) and fill in real values.
# Loaded via `python-dotenv` — see middleware/src/utils.

# Optional: only needed if using the commercial solver backends
GUROBI_LICENSE_PATH=
HEXALY_LICENSE_PATH=

# Optional: experiment tracking
WANDB_API_KEY=

# Tauri Studio (app/src-tauri) — sqlite tracking DB path override
BUILD_OPT_TRACKING_DB=middleware/data/tracking.sqlite3

# SA2: user-local STS2 catalogue cache/overlay directory (gitignored).
# Empty → ~/.local/share/build-optimization/sts2 (or $XDG_DATA_HOME/...).
STS2_CATALOGUE_DIR=
